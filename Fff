    task.spawn(function()
        while spamActive do
            local raw = spamBox.Text
            local tgt = spamTarget.Text
            local final = raw
            if tgt ~= "" and raw ~= "" then
                local parts = string.split(raw, ";")
                local newParts = {}
                for _, part in ipairs(parts) do
                    local trimmed = string.gsub(part, "^%s*(.-)%s*$", "%1")
                    if trimmed ~= "" then table.insert(newParts, trimmed .. " " .. tgt) end
                end
                if #newParts > 0 then final = ";" .. table.concat(newParts, " ;") end
            end
            if spamMode == "chat" then sendChat(final)
            elseif spamMode == "hidden" then sendHD(final)
            else sendChat(final); sendHD(final) end
            local delay = tonumber(spamSpeed.Text) or 1.5
            task.wait(delay)
        end
    end)
end))

