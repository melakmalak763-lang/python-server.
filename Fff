local function make(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props or {}) do o[k] = v end
    o.Parent = parent
    return o
end
local function round(o, px) make("UICorner", {CornerRadius = UDim.new(0, px or 6)}, o) end
local function outline(o, color, thick)
    make("UIStroke", {Color = color or C.line, Thickness = thick or 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end
local function label(parent, text, pos, size, fontSize, color, font, align)
    return make("TextLabel", {
        Position = pos, Size = size, BackgroundTransparency = 1, Text = text,
        TextColor3 = color or C.text, TextSize = fontSize or 14,
        Font = font or Enum.Font.Gotham,
        TextXAlignment = align or Enum.TextXAlignment.Center,
        TextYAlignment = Enum.TextYAlignment.Center, ZIndex = 5
    }, parent)
end
local function mkBtn(parent, text, pos, size, bg, tc)
    local b = make("TextButton", {
        Position = pos, Size = size, BackgroundColor3 = bg or C.bg,
        Text = text, TextColor3 = tc or C.text,
        Font = Enum.Font.GothamBold, TextSize = 13,
        AutoButtonColor = false, ZIndex = 5
    }, parent)
    round(b, 6); outline(b, C.line, 1)
    return b
end
local function mkBox(parent, ph, pos, size)
    local t = make("TextBox", {
        Position = pos, Size = size, BackgroundColor3 = C.bg,
        TextColor3 = C.text, PlaceholderText = ph,
        PlaceholderColor3 = C.textDim, Font = Enum.Font.Gotham,
        TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center,
        ClearTextOnFocus = false, ZIndex = 5
    }, parent)
    round(t, 6); outline(t, C.line, 1)
    return t
end

local function getPlayer(q)
    if not q or q == "" then return nil end
    q = q:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and (p.Name:lower() == q or p.DisplayName:lower() == q) then return p end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and (p.Name:lower():sub(1,#q) == q or p.DisplayName:lower():sub(1,#q) == q) then return p end
    end
    return nil
end
local function getRoot(p) local c = p and p.Character; return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(p) local c = p and p.Character; return c and c:FindFirstChildOfClass("Humanoid") end
local function getTorso(p)
    local c = p and p.Character
    if not c then return nil end
    return c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
end
local function getHead(p) local c = p and p.Character; return c and c:FindFirstChild("Head") end

