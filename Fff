local function toggleAntiAfk(on_)
    if antiAfkConn then antiAfkConn:Disconnect(); antiAfkConn = nil end
    if antiAfkLoopConn then antiAfkLoopConn:Disconnect(); antiAfkLoopConn = nil end
    antiAfkData.enabled = on_
    if not on_ then return end

    antiAfkData.moveTimer = 0
    antiAfkData.jumpTimer = 0
    antiAfkData.clickTimer = 0
    antiAfkData.nextJump = math.random(2, 4)
    captureAfkStart()

    on(LP.CharacterAdded:Connect(function()
        task.wait(1)
        if antiAfkData.enabled then captureAfkStart() end
    end))

    antiAfkConn = on(LP.Idled:Connect(function()
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end))

    antiAfkLoopConn = on(RunService.Heartbeat:Connect(function(dt)
        if not antiAfkData.enabled then return end
        local hum = getHum(LP)
        local root = getRoot(LP)
        if not (hum and root) then return end
        if hum.Health <= 0 then return end

        -- إرجاع لو ابتعد أكثر من 30 ستود
        if antiAfkData.startCF then
            local dist = (root.Position - antiAfkData.startCF.Position).Magnitude
            if dist > 30 then
                pcall(function()
                    root.CFrame = antiAfkData.startCF
                    root.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end

        -- مشي عشوائي كل 1.2 ثانية
        antiAfkData.moveTimer = antiAfkData.moveTimer + dt
        if antiAfkData.moveTimer >= 1.2 then
            antiAfkData.moveTimer = 0
            local angle = math.random() * math.pi * 2
            local dist = math.random(20, 50)
            local base = antiAfkData.startCF and antiAfkData.startCF.Position or root.Position
            local target = Vector3.new(
                base.X + math.cos(angle) * dist,
                base.Y,
                base.Z + math.sin(angle) * dist
            )
            pcall(function() hum:MoveTo(target) end)
        end

        -- قفز عشوائي كل 2-4 ثواني
        antiAfkData.jumpTimer = antiAfkData.jumpTimer + dt
        if antiAfkData.jumpTimer >= antiAfkData.nextJump then
            antiAfkData.jumpTimer = 0
            antiAfkData.nextJump = math.random(2, 4)
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end

        -- نقرة احتياطية كل 5 ثواني
        antiAfkData.clickTimer = antiAfkData.clickTimer + dt
        if antiAfkData.clickTimer >= 5 then
            antiAfkData.clickTimer = 0
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end
    end))
