local shAdminConn
local shHidden = {}
local keywords = {"admin", "cmd", "log", "console", "command"}
local function isTargetGUI(g)
    if not (g:IsA("ScreenGui") or g:IsA("Frame") or g:IsA("BillboardGui")) then return false end
    local n = g.Name:lower()
    if n == "fff" then return false end
    for _, k in ipairs(keywords) do if n:find(k) then return true end end
    return false
end
