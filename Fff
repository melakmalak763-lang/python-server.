local antiAfkConn = nil
local antiAfkLoopConn = nil
local antiAfkData = {
    enabled = false,
    startCF = nil,
    moveTimer = 0,
    jumpTimer = 0,
    clickTimer = 0,
    nextJump = math.random(2, 4),
}

local function captureAfkStart()
    local root = getRoot(LP)
