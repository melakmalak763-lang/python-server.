local function findCuffTool(container)
    if not container then return nil end
    for _, v in ipairs(container:GetChildren()) do
        if v:IsA("Tool") and (v.Name:lower():find("كلبشه") or v.Name:lower():find("cuff")) then
            return v
        end
        if #v:GetChildren() > 0 then
            local f = findCuffTool(v)
            if f then return f end
        end
    end
    return nil
end

